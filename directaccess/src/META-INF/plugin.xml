<idea-plugin>
  <id>com.google.gct.directaccess</id>
  <name>Firebase Direct Access</name>
  <version>1.0</version>
  <vendor>Google</vendor>

  <description>Enables Firebase Direct Access Tab for Device Manager.</description>

  <depends>org.jetbrains.android</depends>
  <depends>com.google.gct.login</depends>
  <depends>com.google.gct.testing</depends>

  <!-- please see http://confluence.jetbrains.net/display/IDEADEV/Build+Number+Ranges for description -->
  <idea-version since-build="107.107"/>
  <extensions defaultExtensionNs="org.jetbrains.android">
    <deviceManagerTab
      implementation="com.google.gct.directaccess.ui.FirebaseDeviceTab"/>
  </extensions>
</idea-plugin>
