<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.google.gct.testrecorder.ui.TestClassNameInputDialog">
  <grid id="27dc6" binding="myRootPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="450" height="96"/>
    </constraints>
    <properties>
      <inheritsPopupMenu value="false"/>
      <minimumSize width="450" height="85"/>
      <opaque value="true"/>
      <preferredSize width="450" height="85"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="fc5aa" class="javax.swing.JLabel" binding="myErrorMessageLabel">
        <constraints border-constraint="South"/>
        <properties>
          <font style="1"/>
          <horizontalAlignment value="4"/>
          <horizontalTextPosition value="4"/>
          <text value="ERROR"/>
        </properties>
      </component>
      <grid id="a3ee6" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="North"/>
        <properties>
          <minimumSize width="450" height="66"/>
          <opaque value="true"/>
          <preferredSize width="450" height="66"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="4a4aa" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints border-constraint="North"/>
            <properties>
              <minimumSize width="450" height="27"/>
              <preferredSize width="450" height="27"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="53264" class="javax.swing.JLabel">
                <constraints border-constraint="West"/>
                <properties>
                  <opaque value="true"/>
                  <text value="Test class name:"/>
                </properties>
              </component>
              <component id="3702" class="javax.swing.JTextArea" binding="myClassNameArea">
                <constraints border-constraint="East"/>
                <properties>
                  <lineWrap value="true"/>
                  <minimumSize width="320" height="27"/>
                  <opaque value="true"/>
                  <preferredSize width="320" height="27"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="1789" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints border-constraint="South"/>
            <properties>
              <minimumSize width="450" height="29"/>
              <preferredSize width="450" height="29"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="d073c" class="javax.swing.JLabel">
                <constraints border-constraint="West"/>
                <properties>
                  <opaque value="true"/>
                  <text value="Test class language:"/>
                </properties>
              </component>
              <component id="286a8" class="javax.swing.JComboBox" binding="myClassLanguageComboBox">
                <constraints border-constraint="East"/>
                <properties>
                  <maximumSize width="320" height="29"/>
                  <minimumSize width="320" height="29"/>
                  <opaque value="true"/>
                  <popupVisible value="false"/>
                  <preferredSize width="320" height="29"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
